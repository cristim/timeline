# Timeline - environment (DEV-1: identical variables in dev and cloud;
# only the values change between MinIO/Caddy and S3/CloudFront).

# Object storage (dev: compose MinIO; cloud: real S3 - unset S3_ENDPOINT there)
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=wkadmin
AWS_SECRET_ACCESS_KEY=wk-dev-minio
AWS_REGION=us-east-1

# Buckets (same names in dev and cloud)
BUCKET_DUMPS=wk-dumps
BUCKET_WARM=wk-warm
BUCKET_ARTIFACTS=wk-artifacts

# Dataset version to bake/publish under /v/<DATASET_VERSION>/
DATASET_VERSION=dev

# Web
VITE_DATA_URL=http://localhost:8080
