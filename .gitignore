# local working data (dumps, MinIO volume, staging) - never committed.
# data/* + negation (not bare data/) so the seed set stays versioned:
# git cannot re-include children of a fully excluded directory.
data/*
!data/seed/
!data/geo/
!data/goldens.json

# The fetched map inputs are rebuilt from pinned upstreams by
# `make fetch-geo` and cached in CI, not carried in the repo: together they are
# ~68 MB of derived data. Their provenance and licence notices ARE committed,
# which is why this excludes generated files rather than the directories.
data/geo/borders/*.geojson
data/geo/paleo/*.geojson
data/geo/basemap/*.pmtiles

# environment
.env
.env.local

# build artifacts
node_modules/
dist/
*.log
.DS_Store

# playwright output
web/test-results/
web/playwright-report/
